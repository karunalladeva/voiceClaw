# VoiceClaw Environment Configuration

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- Web search (SearXNG Docker, optional) ---
# Prefer Admin → Settings → SearXNG. Env vars override workspace/config.json when set.
# SEARXNG_URL=http://localhost:7979
# SEARXNG_ENABLED=true
# SEARXNG_CATEGORIES=general
# SEARXNG_TIME_RANGE=
# SEARXNG_LANGUAGE=en
# WEB_SEARCH_HTTP_FALLBACK=true
# WEB_SEARCH_BROWSER_FALLBACK=true
# WEB_FETCH_MAX_CHARS=12000
# WEB_FETCH_PROXY_URL=
# WEB_FETCH_IGNORE_TLS_ERRORS=false

# --- Agent prompt budget (optional) ---
# AGENT_MAX_PROMPT_CHARS=30000
# PIPELINE_CONTEXT_MAX_CHARS=15000
# DEBUG_PROMPT=1

# --- MCP Credentials ---

# GitHub MCP
# Get a Personal Access Token from https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Google MCP (Gmail & Google Cloud Products)
# Set up a Google Cloud Project and enable Gmail/Drive/Sheets APIs.
# Download your OAuth 2.0 credentials JSON and set the path or provide individual values.
# See: https://github.com/modelcontextprotocol/servers/tree/main/src/google-cloud
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# MongoDB (Optional for Memory MCP)
MONGO_URI=mongodb://localhost:27017

# --- Channel Input Credentials ---

# Discord Bot Token (for receiving messages)
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Telegram Bot Token (for receiving messages)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- ComfyUI (Optional image/video generation) ---
# ComfyUI server URL when comfyui.enabled is true in workspace/config.json
COMFYUI_BASE_URL=http://127.0.0.1:8000
# Unload local Ollama/llama.cpp/LM Studio during ComfyUI jobs: workspace/config.json → comfyui.unloadLocalModelOnGenerate (default true)

# llama.cpp llama-server (router mode) — optional default when model baseUrl is unset
# LLAMACPP_BASE_URL=http://localhost:8080

# --- Orchestration (org agent heartbeats) ---
# How often idle agents poll for work when no task event fired (milliseconds, min 15000)
ORG_HEARTBEAT_INTERVAL_MS=15000
# Optional TTL for pipeline-mode local model pin (milliseconds). Omit for no expiry.
# ORG_PIPELINE_PIN_TTL_MS=3600000

# --- LLM Provider Settings (Optional, defaults to Ollama) ---
# OLLAMA_REQUEST_TIMEOUT_MS=900000
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Observability (Local LangSmith) ---
# To use LangSmith locally, run their official Docker container or LangGraph Studio.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=http://localhost:1984
LANGCHAIN_API_KEY=none
LANGCHAIN_PROJECT=VoiceClaw
