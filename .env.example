# VoiceClaw Environment Configuration

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- MCP Credentials ---

# GitHub MCP
# Get a Personal Access Token from https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# Google MCP (Gmail & Google Cloud Products)
# Set up a Google Cloud Project and enable Gmail/Drive/Sheets APIs.
# Download your OAuth 2.0 credentials JSON and set the path or provide individual values.
# See: https://github.com/modelcontextprotocol/servers/tree/main/src/google-cloud
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# MongoDB (Optional for Memory MCP)
MONGO_URI=mongodb://localhost:27017

# --- Channel Input Credentials ---

# Discord Bot Token (for receiving messages)
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Telegram Bot Token (for receiving messages)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- LLM Provider Settings (Optional, defaults to Ollama) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Observability (Local LangSmith) ---
# To use LangSmith locally, run their official Docker container or LangGraph Studio.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=http://localhost:1984
LANGCHAIN_API_KEY=none
LANGCHAIN_PROJECT=VoiceClaw
